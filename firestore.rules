rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Personal plan: readable and writable only by its owner.
    match /plans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared plans behind a share link:
    //  - anyone with the (unguessable) link can read and edit the plan
    //  - only signed-in users can create shares, and only their own
    //  - the owner field cannot be changed by editors
    //  - only the owner can revoke the link (delete the document)
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
